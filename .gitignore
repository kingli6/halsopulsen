# Dependencies
node_modules/

# Runtime/local data
storage/

# Replit and other machine-local workspace state
.cache/
.upm/
.local/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store

# Temporary files, logs, and local process artifacts
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
